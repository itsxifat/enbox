# Dev/preview proxy target for /api, /uploads and /socket.io
ENBOX_API_URL=http://localhost:4000
# Dev server port / host (PORT is intentionally not used — the server reads it)
WEB_PORT=5173
# WEB_HOST=0.0.0.0

# Absolute API origin baked into the client (Capacitor / split deployments). Empty = same origin.
VITE_API_URL=
# Register the service worker during `vite dev` (always registered in production builds)
VITE_ENABLE_SW=false
