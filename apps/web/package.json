{
  "name": "@enbox/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enbox web / PWA client (React, Vite, Tailwind).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@enbox/shared": "0.1.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cherry-bomb-one": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
