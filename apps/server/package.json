{
  "name": "@enbox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enbox API + realtime server (Express, Socket.IO, PostgreSQL via Drizzle).",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@enbox/shared": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "redis": "^5.8.0",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.7"
  }
}
