# ---------------------------------------------------------------------------
# Enbox server configuration (copy to apps/server/.env or export in your shell)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public origin of the web app (used to build invite links)
PUBLIC_URL=http://localhost:5173

# PostgreSQL connection. Leave empty to use the embedded PGlite database in DATA_DIR.
DATABASE_URL=
# DATABASE_URL=postgres://enbox:enbox@localhost:5432/enbox
DATA_DIR=./data
# UPLOAD_DIR=./data/uploads

# Comma-separated list of allowed browser origins ('*' = any)
CORS_ORIGINS=*

# Optional: Redis for multi-instance Socket.IO fan-out
REDIS_URL=

SESSION_TTL_DAYS=90
LOG_LEVEL=info

# WebRTC ICE servers. STUN works for most networks; configure TURN (e.g. coturn) for
# users behind symmetric NATs / strict firewalls.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
# Either static credentials...
TURN_USERNAME=
TURN_CREDENTIAL=
# ...or coturn's static-auth-secret for short-lived REST credentials (preferred)
TURN_SECRET=
TURN_TTL_SEC=86400

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
